{
  "name": "seed-demo",
  "description": "Domain-agnostic 3-node chain for Living Node Swarm v0.1",
  "nodes": [
    {
      "id": "input_signal",
      "name": "Input signal",
      "distribution_family": "Normal",
      "parameters": { "mu": 0.0, "sigma": 1.0 },
      "depends_on": [],
      "transform": "none",
      "status": "active"
    },
    {
      "id": "process_stage",
      "name": "Process stage",
      "distribution_family": "Normal",
      "parameters": { "mu": 0.0, "sigma": 0.3 },
      "depends_on": ["input_signal"],
      "transform": "affine",
      "transform_params": { "a0": 0.0, "a1": 1.2 },
      "status": "active"
    },
    {
      "id": "outcome",
      "name": "Outcome",
      "distribution_family": "Normal",
      "parameters": { "mu": 0.0, "sigma": 0.2 },
      "depends_on": ["process_stage"],
      "transform": "affine",
      "transform_params": { "a0": 0.5, "a1": 0.8 },
      "status": "active"
    }
  ]
}
