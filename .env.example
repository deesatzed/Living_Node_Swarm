# Copy to .env for local server (never commit real keys)
OPENROUTER_API_KEY=

# OpenRouter model ids (you choose — no product hard-code)
# Used as default for AI propose (preferred order: reasoning → OPENROUTER_MODEL → fast)
MODEL_REASONING=
MODEL_FAST=
# Optional single default alias
# OPENROUTER_MODEL=

# Optional
# LNS_DB_PATH=
# Server binds 127.0.0.1 by default

# --- Kalshi (research MCP; default demo) ---
# Do NOT paste a multiline PEM into this file (dotenv only keeps the first line).
# Write the RSA private key to a file (chmod 600) and point at it:
KALSHI_ENV=demo
# KALSHI_API_KEY=                 # Kalshi API Key ID
# KALSHI_API_KEY_ID=              # alias for KALSHI_API_KEY (optional)
# KALSHI_PRIVATE_KEY_PATH=/absolute/path/to/kalshi_private.pem
